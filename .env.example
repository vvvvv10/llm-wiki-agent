# ===== 服务 =====
APP_HOST=0.0.0.0
APP_PORT=8080
# 本机 / Docker 访问端口
HOST_PORT=8081


# ===== Wiki =====
WIKI_ROOT=wiki

# ===== 模型（OpenAI Compatible 中转站）=====
LLM_BASE_URL=http://localhost:8001/v1
LLM_API_KEY=change-me-llm-api-key
LLM_MODEL=3.8-max
LLM_TIMEOUT_SECONDS=30

# ===== 检索 =====
RETRIEVAL_TOP_K=5
RETRIEVAL_MIN_SCORE=0.1
MAX_CONTEXT_CHARS=12000
CHUNK_MAX_CHARS=1200
CHUNK_OVERLAP_CHARS=120
HISTORY_MAX_MESSAGES=6

# ===== 钉钉 Worker =====
DINGTALK_CLIENT_ID=
DINGTALK_CLIENT_SECRET=
# 场景能力 ID：注册钉钉 AI 助理直通模式技能（GraphMessage.TOPIC），留空则仅启用群机器人
DINGTALK_SCENARIO_CAPABILITY_ID=
# 流式打字机卡片回复（FR-036/GAP-002）：true 时用 AI Markdown 卡片逐 token 更新，
# 卡片创建失败自动回退纯文本；false 时保持一次性纯文本回复
DINGTALK_STREAMING_CARD=true
